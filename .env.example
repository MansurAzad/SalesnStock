# Environment variables for deploying outside Lovable (e.g. Vercel).
# Copy the real values from .env / your backend settings.

# Browser (embedded at build time; already present in the committed .env)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server runtime (required; set these in the hosting dashboard,
# e.g. Vercel → Project Settings → Environment Variables)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server runtime (optional)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...  # privileged admin operations; bypasses row-level security
# LOVABLE_API_KEY=...                      # AI insights page (Lovable AI Gateway)
